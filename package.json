{
  "name": "panghu-image-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c green,cyan \"npm:dev:api\" \"npm:dev:web\"",
    "dev:web": "vite --host 0.0.0.0",
    "dev:api": "node server.js",
    "build": "vite build",
    "preview": "node server.js",
    "preview:web": "vite preview --host 0.0.0.0"
  },
  "dependencies": {
    "concurrently": "^9.2.1",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "lucide": "^0.468.0",
    "multer": "^2.1.1",
    "sharp": "^0.34.5",
    "vite": "^6.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0"
  }
}
